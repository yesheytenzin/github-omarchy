def graphql_payload() -> dict:
    return {
        "data": {
            "viewer": VIEWER,
            # Mirrors GitHub: the org field wraps its connection.
            "orgRepos0": {"repositories": ORG_REPOS},
            "orgRepos1": {"repositories": {"totalCount": 0, "pageInfo": {"hasNextPage": False}, "nodes": []}},
            "mineIssues": search(3, [ISSUE, SECOND_ISSUE]),
            "minePrs": search(2, [PULL, APPROVED_PULL]),
            "orgIssues0": search(4, [ORG_ISSUE]),
            "orgPrs0": search(0, []),
            "orgIssues1": search(0, []),
            "orgPrs1": search(1, [ORG_PULL]),
        }
    }


def bump(name: str) -> int:
    """Count calls across processes, so `flaky` can fail only the first time."""
    if not STATE:
        return 0
    path = os.path.join(STATE, name)
    try:
        with open(path, encoding="utf-8") as handle:
            count = int(handle.read().strip() or "0")
    except (OSError, ValueError):
        count = 0
    count += 1
    os.makedirs(STATE, exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(str(count))
    return count


def log_invocation(args: list[str]) -> None:
    if not LOG:
        return
    with open(LOG, "a", encoding="utf-8") as handle:
        handle.write(" ".join(args) + "\n")


def main() -> int:
    args = sys.argv[1:]
    log_invocation(args)

    if args[:2] == ["api", "user"]:
        if MODE == "no-auth":
            print("To get started with GitHub CLI, please run: gh auth login", file=sys.stderr)
            return 4
        print(LOGIN)
        return 0

    if args[:2] == ["api", "user/orgs"]:
        print("acme-corp")
        return 0

    if args[:1] == ["api"] and args[1].startswith("user/repos"):
        print("acme-corp")
        print("OtherOrg")
        return 0

    if args[:2] == ["api", "graphql"]:
        if MODE == "auth-error":
            print("gh: To get started with GitHub CLI, please run: gh auth login", file=sys.stderr)
            return 4
        if MODE == "hang":
            time.sleep(30)
            return 0
        if MODE == "flaky" and bump("graphql") == 1:
            print("<html><body>502 Bad Gateway</body></html>")
            return 1
        if MODE == "broken":
            print("this is not json")
            return 0
        print(json.dumps(graphql_payload()))
        return 0

    print(f"fake gh: unhandled call: {args}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
