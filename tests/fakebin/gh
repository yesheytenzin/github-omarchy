def search(count: int, nodes: list) -> dict:
    return {"issueCount": count, "pageInfo": {"hasNextPage": False}, "nodes": nodes}


def repo(name, pushed, open_issues, open_prs, owner_type, owner, starred=False, private=False, archived=False, stars=0):
    return {
        "nameWithOwner": name,
        "url": "https://github.com/" + name,
        "isPrivate": private,
        "isArchived": archived,
        "pushedAt": pushed,
        "stargazerCount": stars,
        "viewerHasStarred": starred,
        "owner": {"login": owner, "__typename": owner_type},
        "issues": {"totalCount": open_issues},
        "pullRequests": {"totalCount": open_prs},
    }


